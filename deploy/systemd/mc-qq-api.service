# Candidate template based on the deployment conventions.

[Unit]
Description=MC-QQ-Auth FastAPI
After=network.target

[Service]
Type=exec
User=root
WorkingDirectory=/opt/mc-qq-auth/bot
ExecStart=/opt/mc-qq-auth/bot/.venv/bin/python -m uvicorn mc_api:app --host 127.0.0.1 --port 18765 --workers 1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
