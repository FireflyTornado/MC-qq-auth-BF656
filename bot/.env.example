# Copy to bot/.env and fill in every placeholder before starting the services.
DRIVER=~websockets
LOG_LEVEL=INFO
ONEBOT_WS_URLS=["ws://127.0.0.1:13001/"]
ONEBOT_ACCESS_TOKEN=REPLACE_WITH_ONEBOT_ACCESS_TOKEN

# Replace 0 with the numeric ID of the target QQ group.
TARGET_GROUP_ID=0

# Optional. NoneBot superusers allowed to run /info and /reconcile in the target group.
# SUPERUSERS=["REPLACE_WITH_ADMIN_QQ_ID"]

# Use distinct values. The API token is for snapshot and WebSocket clients.
MC_API_TOKEN=REPLACE_WITH_MC_API_TOKEN
MC_NOTIFY_TOKEN=REPLACE_WITH_MC_NOTIFY_TOKEN

# Optional. Keep this endpoint on a trusted network.
# MC_NOTIFY_URL=http://127.0.0.1:18765/internal/mc/notify

# Optional /sudo access in TARGET_GROUP_ID. Leave unset or [] to disable.
# MC_SUDO_QQ_IDS=["123456789"]
# MC_SUDO_BOT_TOKEN=REPLACE_WITH_MC_SUDO_BOT_TOKEN
# MC_SUDO_PLUGIN_TOKEN=REPLACE_WITH_MC_SUDO_PLUGIN_TOKEN
# Reply as a UTF-8 TXT file when any threshold is exceeded.
# MC_SUDO_FILE_LINE_THRESHOLD=10
# MC_SUDO_FILE_LINE_CHAR_THRESHOLD=0
# MC_SUDO_TEXT_MAX_CHARS=1500

# Optional. Minecraft Java server address used by /info (hostname or hostname:port).
# MC_STATUS_ADDRESS=play.example.org:25565
