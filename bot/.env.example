# Copy to bot/.env and fill in every placeholder before starting the services.
DRIVER=~websockets
LOG_LEVEL=INFO
ONEBOT_WS_URLS=["ws://127.0.0.1:13001/"]
ONEBOT_ACCESS_TOKEN=REPLACE_WITH_ONEBOT_ACCESS_TOKEN

# Replace 0 with the numeric ID of the target QQ group.
TARGET_GROUP_ID=0

# Optional. NoneBot superusers allowed to run /授权对账 in the target group.
# SUPERUSERS=["REPLACE_WITH_ADMIN_QQ_ID"]

# Use distinct values. The API token is for snapshot and WebSocket clients.
MC_API_TOKEN=REPLACE_WITH_MC_API_TOKEN
MC_NOTIFY_TOKEN=REPLACE_WITH_MC_NOTIFY_TOKEN

# Optional. Keep this endpoint on a trusted network.
# MC_NOTIFY_URL=http://127.0.0.1:18765/internal/mc/notify
